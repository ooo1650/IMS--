# Copy to .env (never commit real values).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=ims.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ims.example.com
DATABASE_URL=postgres://ims:ims@db:5432/ims

# Cash totals round to this many paisa (100 = nearest rupee); 1 = no rounding.
IMS_CASH_ROUNDING_PAISA=1
IMS_CASHIER_MAX_DISCOUNT_BP=500
IMS_RETURN_APPROVAL_THRESHOLD=500000

# CBMS credentials are entered in the app (Tax & IRD → Settings) and stored encrypted.
# Optional dedicated key for that encryption (else derived from DJANGO_SECRET_KEY):
CBMS_ENCRYPTION_KEY=

# FonePay: "mock" until the bank's official API docs and credentials arrive.
FONEPAY_BACKEND=mock
FONEPAY_BASE_URL=
FONEPAY_MERCHANT_CODE=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_SECRET=
