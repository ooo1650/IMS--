# For running without Docker (Docker uses the repo-root .env.example). Copy to .env; never commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=ims.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ims.example.com,https://ims.example.com:8443
DATABASE_URL=postgres://ims_app:CHANGE-ME@localhost:5432/ims
# Run migrations as the owner, then `manage.py ensure_db_roles` (needs IMS_APP_DB_PASSWORD).

# Email, sign-in rules and per-business shop rules are set in the operator
# console (stored in the database). Create the first operator with
# `manage.py create_platform_admin`; serve frontend/dist-console for the console.

# CBMS credentials are entered in the app (Tax & IRD → Settings) and stored encrypted.
# Optional dedicated key for that encryption (else derived from DJANGO_SECRET_KEY):
CBMS_ENCRYPTION_KEY=

# FonePay is configured in the app (Admin → Branches & registers → FonePay):
# mode, API address and each branch's merchant credentials are stored in the
# database, secrets encrypted with CBMS_ENCRYPTION_KEY. Only guard rails here:
# allow demo mode (anyone at the till can mark a QR paid; dev/demo only) and the
# domains the API address may use.
IMS_ALLOW_FONEPAY_MOCK=false
IMS_FONEPAY_HOSTS=fonepay.com
