# docker compose reads ./.env. Copy this file to .env and fill it in; never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Public hostname only: no http:// and no port (e.g. ims.yourshop.com). DNS must point
# here and port 80 must be open; the certbot service then gets a Let's Encrypt
# certificate. "localhost" or a LAN name/IP gets a self-signed certificate.
IMS_DOMAIN=ims.example.com
# Optional: Let's Encrypt sends certificate-expiry warnings here.
LETSENCRYPT_EMAIL=

# Django session/CSRF signing key. Changing it logs everyone out.
DJANGO_SECRET_KEY=

# Database owner (migrations + backups only) and the app's least-privilege role.
POSTGRES_PASSWORD=
IMS_APP_DB_PASSWORD=

# Encrypts the CBMS password stored in the app. Set once and keep it: losing it
# means re-entering the CBMS password. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CBMS_ENCRYPTION_KEY=

# Who may open /django-admin (space-separated CIDRs). Default: private networks only.
IMS_ADMIN_ALLOW=private_ranges

# Operator console (businesses, branches, admin accounts, email, jobs): served on
# https://IMS_DOMAIN:8443, or on its own subdomain when IMS_CONSOLE_DOMAIN is set
# (DNS must point it here; it joins the TLS certificate). IMS_CONSOLE_ALLOW lists
# the networks that may open it (space-separated CIDRs; default private networks).
# Create the first operator once:  docker compose run --rm migrate manage create_platform_admin --username op --email you@example.com
IMS_CONSOLE_DOMAIN=
IMS_CONSOLE_ALLOW=private_ranges
# Console hosted on ANOTHER server (see console/README.md): its public address and
# the address(es) its proxy connects from. IMS_CONSOLE_ALLOW then lists the
# operators' own networks (their real addresses, not the proxy's).
IMS_CONSOLE_ORIGIN=
IMS_CONSOLE_PROXY=
# Trying the separate console locally: `docker compose --profile console up -d`
# serves it on this port; set IMS_CONSOLE_ORIGIN=http://localhost:8081 to sign in.
IMS_CONSOLE_STANDALONE_PORT=8081

# Email (SMTP), sign-in code roles, lockout limits and each business's shop rules
# (cash rounding, discount limit, return approval) are set in the console and
# stored in the database. Old EMAIL_* / IMS_* values are copied in once on upgrade.

# Console "Load demo businesses" (into an empty install). Demo/test boxes only.
IMS_ALLOW_DEMO_SEED=false

# Optional extra connect-src origins for the browser (e.g. a print endpoint on https).
IMS_CSP_CONNECT_EXTRA=

# TESTING PHASE ONLY. true = a "Test sign-in" list on the login page: one click
# signs in as any user, no password or emailed code. Only answers requests from
# private/loopback networks, logs every use, and shows a warning banner.
# Must be false (or removed) on any server real staff use.
IMS_TEST_LOGIN=false

# FonePay is configured in the app (Admin → Branches & registers → FonePay):
# mode, API address and each branch's merchant credentials are stored in the
# database, secrets encrypted with CBMS_ENCRYPTION_KEY. Only guard rails here:
# allow demo mode (anyone at the till can mark a QR paid; dev/demo only) and the
# domains the API address may use.
IMS_ALLOW_FONEPAY_MOCK=false
IMS_FONEPAY_HOSTS=fonepay.com
