# docker compose reads ./.env. Copy this file to .env and fill it in; never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Public hostname (DNS must point here; Caddy gets the TLS certificate automatically).
IMS_DOMAIN=ims.example.com

# Django session/CSRF signing key. Changing it logs everyone out.
DJANGO_SECRET_KEY=

# Database owner (migrations + backups only) and the app's least-privilege role.
POSTGRES_PASSWORD=
IMS_APP_DB_PASSWORD=

# Encrypts the CBMS password stored in the app. Set once and keep it: losing it
# means re-entering the CBMS password. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CBMS_ENCRYPTION_KEY=

# Who may open /django-admin (space-separated CIDRs). Default: private networks only.
IMS_ADMIN_ALLOW=private_ranges

# FonePay: "disabled" until the bank's API is confirmed. "mock" is for demos only:
# anyone who can sell can mark a QR as paid.
# Merchant code, username, password and secret key are set PER BRANCH in the app
# (Admin → Branches & registers → FonePay) and stored encrypted.
FONEPAY_BACKEND=disabled
FONEPAY_BASE_URL=
# Optional fallback key for verifying callbacks for branches without their own secret.
FONEPAY_SECRET=

# Email for sign-in codes and password resets (any SMTP provider). Without
# EMAIL_HOST, emails are only printed to the backend log: nobody can sign in
# as a role in IMS_2FA_REQUIRED_ROLES or reset a password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=sudipdahal099@gmail.com
EMAIL_HOST_PASSWORD=bkzh qkmv ecvr kije
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=IMS <no-reply@example.com>
IMS_2FA_REQUIRED_ROLES=SuperAdmin,OrgAdmin,BranchManager

# Optional extra connect-src origins for the browser (e.g. a print endpoint on https).
IMS_CSP_CONNECT_EXTRA=

# Business rules.
IMS_CASH_ROUNDING_PAISA=1
IMS_CASHIER_MAX_DISCOUNT_BP=500
IMS_RETURN_APPROVAL_THRESHOLD=500000
