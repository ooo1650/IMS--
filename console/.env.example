# Operator console on its own server. Copy to .env (never commit .env).

# Where the IMS server's console endpoint is: its domain on port 8443.
IMS_API_URL=https://ims.example.com:8443
# Optional: Host name to present to the IMS server, if IMS_API_URL uses a name
# the IMS server doesn't know (e.g. an internal IP). Usually leave empty.
IMS_API_HOST=

# Port the console listens on (plain HTTP; put HTTPS in front: see below).
CONSOLE_PORT=8080

# For `docker compose --profile https up -d`: the console's public name, e.g.
# console.example.com. Caddy gets its certificate automatically.
CONSOLE_DOMAIN=

# Then on the IMS server's .env:
#   IMS_CONSOLE_ORIGIN=https://console.example.com
#   IMS_CONSOLE_PROXY=<this server's IP as the IMS server sees it>
#   IMS_CONSOLE_ALLOW=<the operators' own networks>
